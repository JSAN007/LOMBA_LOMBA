rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    match /friendships/{pairId} {
      function verified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function member() {
        return verified() && request.auth.uid in resource.data.members;
      }
      allow get: if verified() && (!exists(/databases/$(database)/documents/friendships/$(pairId)) || request.auth.uid in resource.data.members);
      allow list: if member() && request.query.limit != null && request.query.limit <= 200;
      allow create: if verified()
        && request.resource.data.keys().hasAll(['members', 'sender', 'recipient', 'senderName', 'recipientName', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['members', 'sender', 'recipient', 'senderName', 'recipientName', 'status', 'createdAt'])
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.recipient is string
        && request.resource.data.sender != request.resource.data.recipient
        && request.resource.data.members == (request.resource.data.sender < request.resource.data.recipient
          ? [request.resource.data.sender, request.resource.data.recipient]
          : [request.resource.data.recipient, request.resource.data.sender])
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.senderName == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.displayName
        && request.resource.data.recipientName == get(/databases/$(database)/documents/players/$(request.resource.data.recipient)).data.displayName;
      allow update: if member()
        && request.auth.uid == resource.data.recipient
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if member();
    }
    match /players/{uid} {
      allow get: if request.auth != null && request.auth.token.email_verified == true;
      allow list: if request.auth != null && request.auth.token.email_verified == true
        && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'searchName'])
        && request.resource.data.keys().hasOnly(['displayName', 'searchName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.searchName == request.resource.data.displayName.lower()
        && request.resource.data.displayName == get(/databases/$(database)/documents/profiles/$(uid)).data.displayName;
      allow delete: if owner(uid);
    }
    match /profiles/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
