rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    match /friendships/{pairId} {
      function verified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function member() {
        return verified() && request.auth.uid in resource.data.members;
      }
      allow get: if verified() && (!exists(/databases/$(database)/documents/friendships/$(pairId)) || request.auth.uid in resource.data.members);
      allow list: if member() && request.query.limit != null && request.query.limit <= 200;
      allow create: if verified()
        && request.resource.data.keys().hasAll(['members', 'sender', 'recipient', 'senderName', 'recipientName', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['members', 'sender', 'recipient', 'senderName', 'recipientName', 'status', 'createdAt'])
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.recipient is string
        && request.resource.data.sender != request.resource.data.recipient
        && request.resource.data.members == (request.resource.data.sender < request.resource.data.recipient
          ? [request.resource.data.sender, request.resource.data.recipient]
          : [request.resource.data.recipient, request.resource.data.sender])
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.senderName == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.displayName
        && request.resource.data.recipientName == get(/databases/$(database)/documents/players/$(request.resource.data.recipient)).data.displayName;
      allow update: if member()
        && request.auth.uid == resource.data.recipient
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if member();
    }
    match /players/{uid} {
      allow get: if request.auth != null && request.auth.token.email_verified == true;
      allow list: if request.auth != null && request.auth.token.email_verified == true
        && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'searchName'])
        && request.resource.data.keys().hasOnly(['displayName', 'searchName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.searchName == request.resource.data.displayName.lower()
        && request.resource.data.displayName == get(/databases/$(database)/documents/profiles/$(uid)).data.displayName;
      allow delete: if owner(uid);
    }
    match /profiles/{uid} {
      match /narrativeAnswers/{questionId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['answer', 'status', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['answer', 'status', 'updatedAt'])
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 4000
          && request.resource.data.status == 'draft'
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /progress/{progressId} {
        function validLevel(item) {
          return item is map
            && item.keys().hasOnly(['id', 'status', 'progress'])
            && item.id is int && item.id >= 1 && item.id <= 4
            && item.status in ['locked', 'unlocked', 'completed']
            && item.progress is number && item.progress >= 0 && item.progress <= 1;
        }
        function validProgress() {
          let data = request.resource.data;
          return data.keys().hasAll(['schemaVersion', 'dailyXp', 'streakDays', 'totalXp', 'level', 'totalLessons', 'successfulLessons', 'completedPracticeLevels', 'levels', 'updatedAt'])
            && data.keys().hasOnly(['schemaVersion', 'dailyXp', 'streakDays', 'totalXp', 'level', 'totalLessons', 'successfulLessons', 'completedPracticeLevels', 'levels', 'updatedAt'])
            && data.schemaVersion == 1
            && data.dailyXp is int && data.dailyXp >= 0 && data.dailyXp <= 100
            && data.streakDays is int && data.streakDays >= 0
            && data.totalXp is int && data.totalXp >= 0
            && data.level is int && data.level >= 1
            && data.totalLessons is int && data.totalLessons >= 0
            && data.successfulLessons is int && data.successfulLessons >= 0
            && data.successfulLessons <= data.totalLessons
            && data.completedPracticeLevels is list && data.completedPracticeLevels.size() <= 50
            && data.levels is list && data.levels.size() == 4
            && validLevel(data.levels[0]) && validLevel(data.levels[1])
            && validLevel(data.levels[2]) && validLevel(data.levels[3])
            && data.updatedAt == request.time;
        }
        allow read: if owner(uid) && progressId == 'current';
        allow create, update: if owner(uid) && progressId == 'current' && validProgress();
        allow delete: if false;
      }
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
